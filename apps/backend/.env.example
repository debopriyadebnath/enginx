# ── Convex ──────────────────────────────────────────────────────────────────
# Your Convex deployment URL (same value as NEXT_PUBLIC_CONVEX_URL in the frontend)
CONVEX_URL=https://<your-deployment>.convex.cloud

# ── JWT / Auth ───────────────────────────────────────────────────────────────
# RSA private key used to sign session JWTs.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Paste the key on a single line (replace newlines with spaces) or use a secrets manager.
# ⚠️  NEVER commit the real key — put this in your hosting platform's secret store.
JWT_PRIVATE_KEY=<paste-single-line-pkcs8-private-key>

# Public JWKS (safe to commit — public keys only).
# Copy from your Convex dashboard → Environment Variables → JWKS.
JWKS={"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Full URL of the Next.js frontend. Separate multiple origins with commas.
FRONTEND_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Custom Socket.IO path (must match NEXT_PUBLIC_SOCKET_IO_PATH in the frontend)
# SOCKET_IO_PATH=/socket.io

# SuperPlane control-plane API key (only needed for /api/integrations/superplane)
# SUPERPLANE_API_TOKEN=<your-token>
